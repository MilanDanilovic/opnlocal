{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opnlocal",
  "version": "0.1.0",
  "identifier": "io.github.milandanilovic.opnlocal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "opnlocal",
        "width": 1120,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "opnlocal",
    "category": "Productivity",
    "shortDescription": "Run AI models privately on your own device",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "libs/": "./"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 28
    },
    "iOS": {
      "minimumSystemVersion": "17.0"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
